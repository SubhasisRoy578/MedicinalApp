# Database (Defaults to SQLite automatically if empty, or set PostgreSQL)
DATABASE_URL=sqlite:///./medikiosk.db

# JWT Security
JWT_SECRET=super-secret-medikiosk-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Provider ("clinical_engine", "gemini", "openai")
AI_PROVIDER=clinical_engine
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-1.5-flash

# OCR Settings (Optional custom path if Tesseract is not in system PATH)
TESSERACT_CMD=
UPLOAD_DIR=./uploads
